{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // papio (GitHub, private) is scanned by the self-hosted Renovate on nas-vm's
  // Forgejo Actions runner (a github-platform pass in ellis/Nieuwy.com's
  // .forgejo/workflows/renovate.yml), NOT by GitHub Actions — so scans cost no
  // GitHub minutes. Detection-only: one PR per update, each gated by ci.yml.
  // Dependency surfaces: Go modules, GitHub Actions (SHA-pinned), the browser
  // extension's npm/bun devDependencies, and two custom-manager pins: the
  // betterleaks curl pin in ci.yml and govulncheck's Go toolchain in vuln.yml.
  extends: [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
  ],
  labels: ["renovate", "dependencies"],
  // Captured provider fixtures are sanitized snapshots of real pages, not papio
  // dependencies. Renovate must not rewrite libraries embedded in them (e.g. the
  // MathJax CDN URL inside the ProQuest captures).
  ignorePaths: [
    "**/node_modules/**",
    "**/bower_components/**",
    "extension/fixtures/**",
  ],
  prConcurrentLimit: 10,
  rebaseWhen: "behind-base-branch",
  // Renovate bumps go.mod via `go get` but does not tidy go.sum; ci.yml's `tidy`
  // job fails on the resulting stale transitive entries. Run `go mod tidy` after
  // each Go update so PRs land tidy.
  postUpdateOptions: ["gomodTidy"],
  dependencyDashboardTitle: "Renovate · papio dependencies",
  packageRules: [
    {
      // One PR for all action SHA/digest bumps -> one CI run instead of N.
      matchManagers: ["github-actions"],
      groupName: "github-actions",
    },
    {
      // Batch Go non-major bumps; majors stay individual for review.
      matchManagers: ["gomod"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "go modules (non-major)",
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["review-carefully"],
    },
    {
      // pdfcpu minors break its api.* signatures (v0.16 added a parameter to
      // six calls internal/pdf uses), so it gets its own PR instead of
      // blocking the routine Go batch.
      matchManagers: ["gomod"],
      matchDepNames: ["github.com/pdfcpu/pdfcpu"],
      groupName: "pdfcpu",
      addLabels: ["review-carefully"],
    },
    {
      // betterleaks bumps: CI's secrets job WILL fail until BL_SHA256 is
      // updated by hand (Renovate cannot compute a release-asset checksum).
      matchDepNames: ["betterleaks/betterleaks"],
      addLabels: ["manual-hash"],
      prBodyNotes: [
        "**Manual step:** update `BL_SHA256` in `.github/workflows/ci.yml` to the new release's checksum. The `secrets` job fails until then (Renovate cannot recompute a release-asset hash).",
      ],
    },
  ],
  customManagers: [
    {
      // betterleaks is downloaded by curl in ci.yml, pinned by BL_VERSION
      // (e.g. BL_VERSION=1.6.1). Track the upstream github-releases tag
      // (v1.6.1) and strip the leading "v" to match the bare pin.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/ci\\.yml$/"],
      matchStrings: ["BL_VERSION=(?<currentValue>\\S+)"],
      depNameTemplate: "betterleaks/betterleaks",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
    {
      // govulncheck-action's toolchain pin. The github-actions manager reads
      // setup-go's `go-version` but not `go-version-input`, so vuln.yml once sat
      // three patches behind and failed on fixed stdlib CVEs.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/vuln\\.yml$/"],
      matchStrings: ["go-version-input: '(?<currentValue>[^']+)'"],
      depNameTemplate: "go",
      datasourceTemplate: "golang-version",
    },
  ],
}
