{
  "name": "papio-extension",
  "version": "0.15.0",
  "private": true,
  "description": "papio MV3 extension workspace (browser plane; built out in Phase 2). Bun is package manager/scripts only — the shipped artifact is browser JavaScript.",
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "build:watch": "bun run build.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dev:firefox": "web-ext run",
    "dev:chrome": "bun run build.ts --watch --reload",
    "dev": "concurrently -k -n build,firefox -c blue,magenta \"bun run build:watch\" \"bun run dev:firefox\"",
    "capture:store": "bun run scripts/capture-store-assets.ts",
    "adapter:try": "bun run tools/adapter-try.ts",
    "lint:firefox": "bun run build && web-ext lint --source-dir=firefox",
    "submit:firefox": "scripts/submit-firefox.sh",
    "submit:chrome": "scripts/submit-chrome.sh",
    "status:chrome": "bun run scripts/cws-status.ts",
    "status:firefox": "bun run scripts/amo-status.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/chrome": "^0.2.0",
    "concurrently": "^10.0.3",
    "happy-dom": "^20.10.6",
    "puppeteer-core": "^25.3.0",
    "typescript": "^7.0.0",
    "web-ext": "^10.5.0"
  }
}
